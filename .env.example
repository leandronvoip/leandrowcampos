# Copie para .env (local) ou cadastre em Cloudflare Pages > Settings > Environment variables.
# Todas começam com PUBLIC_ porque são usadas no navegador: não coloque segredos aqui.

# Webhook do n8n que recebe o JSON dos formulários (POST). Vazio = formulário mostra erro de configuração.
PUBLIC_LEAD_WEBHOOK_URL=

# Meta Pixel. Vazio = pixel desligado.
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (formato G-XXXXXXXXXX). Vazio = GA4 desligado.
PUBLIC_GA4_ID=
