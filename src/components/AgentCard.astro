---
/**
 * Cartão de um agente: ícone de linha à esquerda, área e número em texto pequeno,
 * nome e o que faz. O ícone fica em `muted` e só ganha o dourado no primeiro
 * cartão da lista (`highlight`) ou no hover.
 */
import Icon from './Icon.astro';

interface Props {
  index: number;
  name: string;
  text: string;
  /** Texto pequeno acima do nome (ex.: "Atendimento"). */
  area?: string;
  /** Nome do ícone em Icon.astro. */
  icon?: string;
  /** Destaque fixo (primeiro da lista). */
  highlight?: boolean;
  delay?: number;
}
const { index, name, text, area, icon = 'sparkles', highlight = false, delay = 0 } = Astro.props;
---

<article class="card reveal group flex gap-6 p-7 sm:p-8" data-reveal-delay={delay}>
  <span class:list={['mt-1 transition-colors duration-300', highlight ? 'text-accent' : 'text-muted group-hover:text-accent']}>
    <Icon name={icon} />
  </span>
  <div>
    <p class="text-sm text-muted"><span class="tabular-nums">{String(index).padStart(2, '0')}</span>{area && <span> · {area}</span>}</p>
    <h3 class="mt-1 text-xl sm:text-2xl">{name}</h3>
    <p class="mt-3 text-muted">{text}</p>
  </div>
</article>
