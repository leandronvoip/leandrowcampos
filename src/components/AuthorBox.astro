---
import { site } from '../config/site';
interface Props { title?: string; compact?: boolean }
const { title = 'Sobre o autor', compact = false } = Astro.props;
---

<div class:list={['mx-auto flex max-w-3xl flex-col items-center gap-6 text-center sm:flex-row sm:text-left', compact && 'rounded-card border border-line bg-surface p-6']}>
  <img src={site.author.photo} alt={`Foto de ${site.author.name}`} width="160" height="160" loading="lazy" class="size-32 shrink-0 rounded-full border border-line object-cover sm:size-40" />
  <div>
    {!compact && <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">{title}</p>}
    <h3 class="mt-1 text-2xl">{site.author.name}</h3>
    <p class="text-sm text-muted">{site.author.role}</p>
    <div class="mt-3 space-y-2 text-ink/90">
      {site.author.bioShort.map((line) => <p>{line}</p>)}
    </div>
    <a href="/sobre" class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:underline">Conheça a história completa →</a>
  </div>
</div>
