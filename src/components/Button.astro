---
export interface Props {
  href: string;
  /** primary: branco quente com texto escuro; secondary: borda de 1px; ghost: link com seta. */
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Marca o link como checkout: recebe UTMs via data-checkout. */
  checkout?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', checkout = false, class: className = '', ...rest } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 rounded-full font-medium no-underline transition-[background-color,border-color,color,transform] duration-200 active:scale-[0.98]';
const variants = {
  primary: 'bg-ink text-bg hover:bg-white',
  secondary: 'border border-ink/25 text-ink hover:border-ink/70',
  ghost: 'text-accent hover:text-ink px-0! py-0!',
};
const sizes = { md: 'px-6 py-3 text-[0.9375rem]', lg: 'px-8 py-4 text-base' };
---

<a
  href={href}
  data-checkout={checkout ? '' : undefined}
  class:list={[base, variants[variant], sizes[size], className]}
  {...rest}
>
  <slot />
  {variant === 'ghost' && <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>}
</a>
