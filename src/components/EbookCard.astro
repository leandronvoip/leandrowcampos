---
import type { CollectionEntry } from 'astro:content';
import { brl } from '../lib/format';
import { resolveCover } from '../lib/assets';
import BookMockup from './BookMockup.astro';

interface Props { ebook: CollectionEntry<'ebooks'>; delay?: number }
const { ebook, delay = 0 } = Astro.props;
const { data } = ebook;
const href = `/ebook/${ebook.id}/`;
const cover = resolveCover(ebook.id, data.cover);
---

<article class="card reveal flex flex-col overflow-hidden" data-reveal-delay={delay}>
  <a href={href} class="glow block px-8 pb-10 pt-12 no-underline">
    <BookMockup title={data.title} subtitle={data.subtitle} cover={cover} coverAlt={data.coverAlt} width="11.5rem" />
  </a>
  <div class="flex flex-1 flex-col gap-3 border-t border-line p-7">
    {data.featured && <span class="eyebrow text-[0.75rem]">Lançamento</span>}
    <h3 class="text-xl sm:text-2xl"><a href={href} class="no-underline hover:text-muted">{data.title}</a></h3>
    <p class="text-muted">{data.excerpt}</p>
    <div class="mt-auto flex items-center justify-between pt-4">
      <p class="font-display text-xl font-semibold tracking-tight">
        {data.originalPrice && <span class="mr-2 text-sm font-normal text-dim line-through">{brl(data.originalPrice, { cents: false })}</span>}
        {brl(data.price, { cents: false })}
      </p>
      <a href={href} class="text-sm font-medium text-accent no-underline hover:text-ink">Ver e-book →</a>
    </div>
  </div>
</article>
