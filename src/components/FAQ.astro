---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

<div class="mx-auto max-w-3xl border-t border-line">
  {items.map((item, i) => (
    <details class="group border-b border-line reveal" data-reveal-delay={i * 60}>
      <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-left font-display text-lg font-medium tracking-[-0.01em] text-ink sm:text-xl">
        {item.q}
        <span aria-hidden="true" class="relative size-5 shrink-0 text-muted">
          <span class="absolute left-0 top-1/2 h-px w-5 -translate-y-1/2 bg-current"></span>
          <span class="absolute left-1/2 top-0 h-5 w-px -translate-x-1/2 bg-current transition-transform group-open:scale-y-0"></span>
        </span>
      </summary>
      <p class="measure pb-7 text-muted">{item.a}</p>
    </details>
  ))}
</div>
