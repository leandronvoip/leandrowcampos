---
import Logo from './Logo.astro';

const nav = [
  { href: '/ebooks', label: 'E-books' },
  { href: '/blog', label: 'Blog' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/sobre', label: 'Sobre' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70">
  <div class="container-site flex h-16 items-center justify-between gap-4 sm:h-[4.5rem]">
    <a href="/" class="no-underline">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-8 text-[0.9375rem] md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
          class:list={[
            'no-underline transition-colors hover:text-ink',
            current.startsWith(item.href) ? 'text-ink' : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/gratis"
        class="rounded-full border border-ink/25 px-4 py-2 text-sm font-medium text-ink no-underline transition-colors hover:border-ink/60"
      >
        12 tarefas grátis
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex size-10 cursor-pointer items-center justify-center rounded-full border border-line text-ink" aria-label="Abrir menu">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M3 6h14M3 14h14" />
        </svg>
      </summary>
      <nav aria-label="Principal (celular)" class="card-elevated absolute right-0 mt-3 w-60 p-2">
        {nav.map((item) => (
          <a href={item.href} class="block rounded-xl px-4 py-2.5 text-[0.9375rem] text-ink no-underline hover:bg-ink/5">{item.label}</a>
        ))}
        <a href="/gratis" class="mt-1 block rounded-xl bg-ink px-4 py-2.5 text-center text-[0.9375rem] font-medium text-bg no-underline">12 tarefas grátis</a>
      </nav>
    </details>
  </div>
</header>
