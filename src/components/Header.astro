---
import { site } from '../config/site';

const nav = [
  { href: '/ebooks', label: 'E-books' },
  { href: '/blog', label: 'Blog' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/sobre', label: 'Sobre' },
];
const current = Astro.url.pathname;
---

<header class="border-b border-line bg-surface/90 backdrop-blur supports-[backdrop-filter]:bg-surface/75 sticky top-0 z-40">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <!-- [PLACEHOLDER] Logo: substituir o círculo pelo logotipo final. -->
      <span aria-hidden="true" class="inline-block size-8 rounded-full bg-brand-600"></span>
      <span>{site.shortName}</span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 text-sm font-medium md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
          class:list={[
            'hover:text-brand-700 transition-colors',
            current.startsWith(item.href) ? 'text-brand-700' : 'text-ink/80',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/gratis"
        class="rounded-full bg-brand-600 px-4 py-2 text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        Guia grátis
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-md border border-line" aria-label="Abrir menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" />
        </svg>
      </summary>
      <nav aria-label="Principal (celular)" class="absolute right-0 mt-2 w-56 rounded-xl border border-line bg-surface p-2 shadow-card">
        {nav.map((item) => (
          <a href={item.href} class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-surface-alt">{item.label}</a>
        ))}
        <a href="/gratis" class="mt-1 block rounded-lg bg-brand-600 px-3 py-2 text-center text-sm font-semibold text-white">Guia grátis</a>
      </nav>
    </details>
  </div>
</header>
