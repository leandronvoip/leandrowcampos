---
/**
 * Formulário de captura. Envia JSON para PUBLIC_LEAD_WEBHOOK_URL (n8n).
 *
 * Payload enviado:
 * {
 *   nome, email, whatsapp,
 *   consentimentos: { email: boolean, whatsapp: boolean },
 *   origem,            // identificador da captura (ex.: "gratis", "newsletter")
 *   pagina,            // pathname de onde o formulário foi enviado
 *   url,               // URL completa
 *   utms: { utm_source, utm_medium, ..., landing, referrer, first_seen },
 *   enviado_em         // ISO 8601
 * }
 */
export interface Props {
  /** Identificador da captura, vai no campo `origem`. */
  origem: string;
  /** Texto do botão. */
  cta?: string;
  /** Mostra o campo de WhatsApp (opcional para quem preenche). */
  whatsapp?: boolean;
  /** Para onde ir após o sucesso. Vazio = fica na página mostrando a mensagem. */
  redirect?: string;
  /** Texto curto sob o botão. */
  footnote?: string;
  /** Compacto: só e-mail + consentimento (newsletter no rodapé de post, por exemplo). */
  compact?: boolean;
  class?: string;
}

const {
  origem,
  cta = 'Quero receber',
  whatsapp = true,
  redirect = '/obrigado',
  footnote = 'Sem spam. Você sai quando quiser, com um clique.',
  compact = false,
  class: className = '',
} = Astro.props;

const webhookUrl = import.meta.env.PUBLIC_LEAD_WEBHOOK_URL?.trim() || '';
const id = `lead-${origem.replace(/[^a-z0-9]/gi, '-')}-${Math.random().toString(36).slice(2, 7)}`;
---

<form
  id={id}
  class:list={['lead-form grid gap-4', className]}
  data-webhook={webhookUrl}
  data-origem={origem}
  data-redirect={redirect}
  novalidate
>
  {!compact && (
    <div>
      <label for={`${id}-nome`} class="mb-1 block text-sm font-medium">Seu nome</label>
      <input
        id={`${id}-nome`}
        name="nome"
        type="text"
        autocomplete="given-name"
        required
        minlength="2"
        placeholder="Como quer ser chamado?"
        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-base placeholder:text-muted/70 focus:border-brand-500"
      />
    </div>
  )}

  <div>
    <label for={`${id}-email`} class="mb-1 block text-sm font-medium">Seu melhor e-mail</label>
    <input
      id={`${id}-email`}
      name="email"
      type="email"
      autocomplete="email"
      inputmode="email"
      required
      placeholder="voce@empresa.com.br"
      class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-base placeholder:text-muted/70 focus:border-brand-500"
    />
  </div>

  {whatsapp && !compact && (
    <div>
      <label for={`${id}-whatsapp`} class="mb-1 block text-sm font-medium">
        WhatsApp <span class="font-normal text-muted">(opcional)</span>
      </label>
      <input
        id={`${id}-whatsapp`}
        name="whatsapp"
        type="tel"
        autocomplete="tel-national"
        inputmode="tel"
        placeholder="(11) 99999-9999"
        class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-base placeholder:text-muted/70 focus:border-brand-500"
      />
    </div>
  )}

  <!-- Honeypot: campo invisível que robôs preenchem. -->
  <div class="hidden" aria-hidden="true">
    <label for={`${id}-site`}>Site</label>
    <input id={`${id}-site`} name="site" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <fieldset class="grid gap-2 text-sm">
    <legend class="sr-only">Consentimentos</legend>
    <label class="flex items-start gap-2">
      <input type="checkbox" name="consent_email" required class="mt-1 size-4 accent-brand-600" />
      <span>
        Aceito receber e-mails com conteúdos e ofertas de {`Leandro W. Campos`}, conforme a
        <a href="/privacidade" class="underline">política de privacidade</a>.
      </span>
    </label>
    {whatsapp && !compact && (
      <label class="flex items-start gap-2">
        <input type="checkbox" name="consent_whatsapp" class="mt-1 size-4 accent-brand-600" />
        <span>Aceito receber mensagens no WhatsApp (opcional).</span>
      </label>
    )}
  </fieldset>

  <button
    type="submit"
    class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition-colors hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
  >
    <span data-label>{cta}</span>
    <svg data-spinner class="hidden size-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25" />
      <path d="M22 12a10 10 0 0 1-10 10" stroke="currentColor" stroke-width="3" class="opacity-90" />
    </svg>
  </button>

  <p data-status role="status" aria-live="polite" class="hidden rounded-lg px-4 py-3 text-sm"></p>
  {footnote && <p class="text-xs text-muted">{footnote}</p>}
</form>

<script>
  import { getStoredUtms, track } from '../lib/tracking';

  type Status = 'idle' | 'loading' | 'success' | 'error';

  function setStatus(form: HTMLFormElement, status: Status, message = '') {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const spinner = form.querySelector<HTMLElement>('[data-spinner]')!;
    const box = form.querySelector<HTMLElement>('[data-status]')!;

    form.dataset.status = status;
    button.disabled = status === 'loading' || status === 'success';
    spinner.classList.toggle('hidden', status !== 'loading');
    label.textContent =
      status === 'loading' ? 'Enviando…' : status === 'success' ? 'Enviado!' : (label.dataset.original ?? label.textContent);

    box.classList.remove('hidden', 'bg-green-50', 'text-success', 'bg-red-50', 'text-danger');
    if (status === 'success') {
      box.classList.add('bg-green-50', 'text-success');
      box.textContent = message || 'Pronto! Confira seu e-mail nos próximos minutos.';
    } else if (status === 'error') {
      box.classList.add('bg-red-50', 'text-danger');
      box.textContent = message || 'Não conseguimos enviar agora. Tente de novo em instantes.';
    } else {
      box.classList.add('hidden');
      box.textContent = '';
    }
  }

  function validate(form: HTMLFormElement): string | null {
    const data = new FormData(form);
    const nome = String(data.get('nome') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    if (form.querySelector('[name="nome"]') && nome.length < 2) return 'Digite seu nome.';
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return 'Digite um e-mail válido.';
    if (!data.get('consent_email')) return 'Marque o consentimento para receber e-mails.';
    return null;
  }

  async function handleSubmit(event: SubmitEvent) {
    const form = event.currentTarget as HTMLFormElement;
    event.preventDefault();

    if (String(new FormData(form).get('site') ?? '').length > 0) {
      // Honeypot preenchido: finge sucesso e não envia nada.
      setStatus(form, 'success');
      return;
    }

    const error = validate(form);
    if (error) {
      setStatus(form, 'error', error);
      return;
    }

    const webhook = form.dataset.webhook ?? '';
    if (!webhook) {
      setStatus(form, 'error', 'Formulário ainda não configurado (PUBLIC_LEAD_WEBHOOK_URL vazia).');
      return;
    }

    const data = new FormData(form);
    const payload = {
      nome: String(data.get('nome') ?? '').trim(),
      email: String(data.get('email') ?? '').trim().toLowerCase(),
      whatsapp: String(data.get('whatsapp') ?? '').replace(/\D/g, ''),
      consentimentos: {
        email: data.get('consent_email') === 'on',
        whatsapp: data.get('consent_whatsapp') === 'on',
      },
      origem: form.dataset.origem ?? 'desconhecida',
      pagina: location.pathname,
      url: location.href,
      utms: getStoredUtms(),
      enviado_em: new Date().toISOString(),
    };

    setStatus(form, 'loading');
    try {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 15000);
      const res = await fetch(webhook, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      clearTimeout(timer);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      track('Lead', { content_name: payload.origem, content_category: 'lead' });
      setStatus(form, 'success');

      const redirect = form.dataset.redirect;
      if (redirect) {
        const url = new URL(redirect, location.origin);
        url.searchParams.set('origem', payload.origem);
        if (payload.consentimentos.whatsapp) url.searchParams.set('wa', '1');
        setTimeout(() => location.assign(url.toString()), 600);
      }
    } catch (err) {
      console.error('[lead-form]', err);
      setStatus(form, 'error');
    }
  }

  document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
    const label = form.querySelector<HTMLElement>('[data-label]');
    if (label) label.dataset.original = label.textContent ?? '';
    form.addEventListener('submit', handleSubmit);
  });
</script>
