---
/**
 * Logotipo: monograma "LW." inline (herda a cor via currentColor) com o nome
 * ao lado em Inter Tight. Fonte do desenho: brand/logo/lwc-monogram.svg.
 */
import { site } from '../config/site';

interface Props {
  /** Altura do monograma em px. */
  size?: number;
  /** Mostra o nome ao lado do monograma. */
  name?: boolean;
  class?: string;
}
const { size = 28, name = true, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3 text-ink', className]}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    role="img"
    aria-label={name ? undefined : site.name}
    aria-hidden={name ? 'true' : undefined}
    class="shrink-0"
  >
    <g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 14 V50 H26" />
      <path d="M30 28 L35.5 50 L42 36 L48.5 50 L54 28" />
    </g>
    <circle cx="59" cy="48" r="2.6" fill="currentColor" />
  </svg>
  {name && (
    <span class="font-display text-[0.95rem] font-semibold tracking-[0.12em] uppercase leading-none">{site.name}</span>
  )}
</span>
