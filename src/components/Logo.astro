---
/**
 * Logotipo (opção A, 26/10/2026): palavra-marca "Leandro Campos" em Inter Tight,
 * tracking fechado, com ponto final dourado. Sem monograma ao lado do nome.
 * Quando `name` é false (barra mínima, rodapé compacto), mostra o ícone "LC"
 * (brand/logo/lc-icon.svg) herdando a cor via currentColor.
 */
import { site } from '../config/site';

interface Props {
  /** Altura do ícone "LC" em px (só quando name = false). */
  size?: number;
  /** Mostra a palavra-marca; false mostra só o ícone "LC". */
  name?: boolean;
  class?: string;
}
const { size = 28, name = true, class: className = '' } = Astro.props;
---

{name ? (
  <span class:list={['inline-flex items-baseline text-ink font-display font-semibold leading-none tracking-[-0.035em] text-[1.25rem] sm:text-[1.35rem]', className]} aria-label={site.name}>
    <span>{site.name}</span><span class="text-accent" aria-hidden="true">.</span>
  </span>
) : (
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    role="img"
    aria-label={site.name}
    class:list={['shrink-0 text-ink', className]}
  >
    <rect x="2" y="2" width="60" height="60" rx="14" fill="none" stroke="currentColor" stroke-width="2.5" />
    <text x="32" y="41" text-anchor="middle" font-family="'Inter Tight', Inter, -apple-system, 'Helvetica Neue', Arial, sans-serif" font-weight="600" font-size="26" letter-spacing="-1" fill="currentColor">LC</text>
  </svg>
)}
