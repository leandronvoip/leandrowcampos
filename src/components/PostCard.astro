---
import type { CollectionEntry } from 'astro:content';
import { longDate } from '../lib/format';

interface Props { post: CollectionEntry<'posts'>; delay?: number }
const { post, delay = 0 } = Astro.props;
const href = `/blog/${post.id}/`;
---

<article class="card reveal flex flex-col gap-3 p-7" data-reveal-delay={delay}>
  <time datetime={post.data.publishedAt.toISOString()} class="eyebrow text-[0.75rem]">
    {longDate(post.data.publishedAt)}
  </time>
  <h3 class="text-xl sm:text-2xl"><a href={href} class="no-underline hover:text-muted">{post.data.title}</a></h3>
  <p class="text-muted">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="mt-1 flex flex-wrap gap-2">
      {post.data.tags.map((t) => <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>)}
    </ul>
  )}
  <a href={href} class="mt-3 text-sm font-medium text-accent no-underline hover:text-ink">Ler artigo →</a>
</article>
