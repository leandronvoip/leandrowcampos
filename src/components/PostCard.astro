---
import type { CollectionEntry } from 'astro:content';
import { longDate } from '../lib/format';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const href = `/blog/${post.id}/`;
---

<article class="flex flex-col gap-2 rounded-card border border-line bg-surface p-6 shadow-card">
  <time datetime={post.data.publishedAt.toISOString()} class="text-xs uppercase tracking-wide text-muted">
    {longDate(post.data.publishedAt)}
  </time>
  <h3 class="text-xl"><a href={href} class="hover:text-brand-700">{post.data.title}</a></h3>
  <p class="text-sm text-muted">{post.data.description}</p>
  {post.data.tags.length > 0 && (
    <ul class="mt-2 flex flex-wrap gap-2">
      {post.data.tags.map((t) => <li class="rounded-full bg-surface-alt px-2.5 py-0.5 text-xs text-muted">{t}</li>)}
    </ul>
  )}
  <a href={href} class="mt-2 text-sm font-semibold text-brand-700 hover:underline">Ler artigo →</a>
</article>
