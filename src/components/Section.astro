---
export interface Props {
  id?: string;
  /** Fundo alternado. */
  alt?: boolean;
  title?: string;
  eyebrow?: string;
  lead?: string;
  class?: string;
  narrow?: boolean;
}
const { id, alt = false, title, eyebrow, lead, class: className = '', narrow = false } = Astro.props;
---

<section id={id} class:list={['py-14 sm:py-20', alt && 'bg-surface-alt', className]}>
  <div class:list={['container-site', narrow && 'max-w-3xl']}>
    {(title || eyebrow || lead) && (
      <header class="mx-auto mb-10 max-w-3xl text-center">
        {eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-700">{eyebrow}</p>}
        {title && <h2 class="text-3xl sm:text-4xl">{title}</h2>}
        {lead && <p class="mt-4 text-lg text-muted">{lead}</p>}
      </header>
    )}
    <slot />
  </div>
</section>
