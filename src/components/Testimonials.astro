---
interface Props { items: { name: string; role?: string; text: string }[] }
const { items } = Astro.props;
---

<ul class="grid gap-6 md:grid-cols-3">
  {items.map((t) => (
    <li class="flex flex-col rounded-card border border-line bg-surface p-6 shadow-card">
      <blockquote class="flex-1 text-ink/90">“{t.text}”</blockquote>
      <footer class="mt-4 text-sm">
        <p class="font-semibold">{t.name}</p>
        {t.role && <p class="text-muted">{t.role}</p>}
      </footer>
    </li>
  ))}
</ul>
