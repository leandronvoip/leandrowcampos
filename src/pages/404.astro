---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Página não encontrada" description="Esta página não existe." noindex>
  <section class="glow overflow-hidden">
    <div class="container-site max-w-xl py-28 text-center sm:py-40">
      <p class="eyebrow mb-7">Erro 404</p>
      <h1 class="display-1">Página não encontrada.</h1>
      <p class="lead mx-auto mt-8">O endereço pode ter mudado ou nunca existiu. Veja os e-books ou volte ao início.</p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/">Início</Button>
        <Button href="/ebooks" variant="secondary">E-books</Button>
      </div>
    </div>
  </section>
</Base>
