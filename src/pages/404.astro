---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Página não encontrada" description="Esta página não existe." noindex>
  <section class="container-site max-w-xl py-24 text-center">
    <p class="font-display text-6xl font-bold text-brand-200">404</p>
    <h1 class="mt-2 text-3xl">Página não encontrada</h1>
    <p class="mt-4 text-muted">O endereço pode ter mudado ou nunca existiu. Veja os e-books ou volte ao início.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/">Início</Button>
      <Button href="/ebooks" variant="secondary">E-books</Button>
    </div>
  </section>
</Base>
