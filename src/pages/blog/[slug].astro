---
import { render } from 'astro:content';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { loadRenderers } from 'astro:container';
import { getContainerRenderer as getMDXRenderer } from '@astrojs/mdx';
import Base from '../../layouts/Base.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import LeadForm from '../../components/LeadForm.astro';
import EbookBanner from '../../components/EbookBanner.astro';
import { site } from '../../config/site';
import { longDate } from '../../lib/format';
import { getPublishedPosts } from '../../lib/posts';
import { splitForBanner } from '../../lib/html-insert';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);

// Artigos relacionados: mais tags em comum, depois mais recente. Até 3.
const all = (await getPublishedPosts()).filter((p) => p.id !== post.id);
const related = all
  .map((p) => ({ p, score: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.publishedAt.getTime() - a.p.data.publishedAt.getTime())
  .slice(0, 3)
  .map((r) => r.p);

// O artigo é renderizado em HTML e dividido no ponto do banner (ver src/lib/html-insert.ts).
const renderers = await loadRenderers([getMDXRenderer()]);
const container = await AstroContainer.create({ renderers });
const html = await container.renderToString(Content);
const { before, after } = splitForBanner(html);

const url = new URL(`/blog/${post.id}/`, site.url).toString();
const image = new URL(post.data.cover ?? site.defaultOgImage, site.url).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: [image],
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: site.author.name, url: new URL('/sobre/', site.url).toString() },
  publisher: {
    '@type': 'Person',
    name: site.author.name,
    url: site.url,
    image: new URL(site.author.photo, site.url).toString(),
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
  inLanguage: site.lang,
  isAccessibleForFree: true,
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags.join(', ') } : {}),
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  schema={schema}
  noindex={post.data.draft}
>
  <article class="container-site max-w-3xl pb-20 pt-14 sm:pt-20 lg:pb-28 lg:pt-24">
    <header class="mb-14 border-b border-line pb-10">
      <a href="/blog" class="text-sm font-medium text-accent no-underline hover:text-ink">← Blog</a>
      {post.data.draft && <p class="eyebrow mt-6">Rascunho · não publicado</p>}
      <h1 class="display-2 mt-6">{post.data.title}</h1>
      <p class="lead mt-6">{post.data.description}</p>
      <p class="mt-6 text-sm text-muted">
        Por {site.author.name} ·
        <time datetime={post.data.publishedAt.toISOString()}>{longDate(post.data.publishedAt)}</time>
        {post.data.updatedAt && (
          <>
            {' '}· Atualizado em <time datetime={post.data.updatedAt.toISOString()}>{longDate(post.data.updatedAt)}</time>
          </>
        )}
      </p>
      {post.data.tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((t) => <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</li>)}
        </ul>
      )}
    </header>
    {post.data.cover && (
      <img src={post.data.cover} alt="" width="1200" height="630" class="mb-12 w-full rounded-card border border-line object-cover" loading="eager" decoding="async" />
    )}

    {toc.length >= 3 && (
      <nav class="toc reveal" aria-label="Neste artigo">
        <p class="eyebrow text-[0.75rem]">Neste artigo</p>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="prose-site reveal" set:html={before} />
    {after !== null && (
      <>
        <EbookBanner class="my-12" />
        <div class="prose-site" set:html={after} />
      </>
    )}

    <footer class="mt-16 border-t border-line pt-12">
      <EbookBanner />
    </footer>
  </article>

  {related.length > 0 && (
    <section class="section-y-sm">
      <div class="container-site max-w-5xl">
        <p class="eyebrow mb-6">Leia também</p>
        <div class="grid gap-5 md:grid-cols-3">
          {related.map((p, i) => <PostCard post={p} delay={i * 80} />)}
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    // Botão "Copiar" em cada bloco de prompt/código do artigo.
    (function () {
      var blocks = document.querySelectorAll('.prose-site pre');
      if (!blocks.length || !navigator.clipboard) return;
      blocks.forEach(function (pre) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.textContent = 'Copiar';
        btn.setAttribute('aria-label', 'Copiar o texto deste bloco');
        btn.addEventListener('click', function () {
          var code = pre.querySelector('code');
          var text = (code || pre).innerText.replace(/\n$/, '');
          navigator.clipboard.writeText(text).then(function () {
            btn.textContent = 'Copiado';
            btn.classList.add('is-done');
            setTimeout(function () { btn.textContent = 'Copiar'; btn.classList.remove('is-done'); }, 2000);
          });
        });
        pre.appendChild(btn);
      });
    })();
  </script>

  <section class="section-y-sm bg-surface">
    <div class="container-site grid max-w-5xl gap-6 lg:grid-cols-2">
      <div class="reveal"><AuthorBox compact /></div>
      <div class="card-elevated reveal p-7" data-reveal-delay="120">
        <h2 class="text-xl sm:text-2xl">Gostou? Receba os próximos</h2>
        <p class="mb-6 mt-2 text-sm text-muted">Um e-mail por semana, sem spam.</p>
        <LeadForm origem={`blog-${post.id}`} cta="Assinar" compact redirect="" footnote="" />
      </div>
    </div>
  </section>
</Base>
