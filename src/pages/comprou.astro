---
/**
 * Página de pós-compra. Configure na Hotmart como "página de obrigado" externa
 * para o produto 8764405. Não recebe dados da compra: só orienta o próximo passo.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
---

<Base title="Compra confirmada" description="Próximos passos após a compra." noindex minimal>
  <section class="glow overflow-hidden">
    <div class="container-site max-w-2xl py-20 text-center sm:py-28">
      <p class="eyebrow mb-7">Compra confirmada</p>
      <h1 class="display-2">Obrigado. Seu e-book está a caminho.</h1>
      <p class="lead mx-auto mt-8">
        A Hotmart envia em instantes um e-mail com o acesso à área de membros. Lá ficam o PDF, os bônus e as futuras atualizações.
      </p>

      <ol class="mt-14 space-y-4 text-left">
        {[
          ['Procure o e-mail da Hotmart', 'O remetente é a Hotmart. Se não aparecer em alguns minutos, confira a caixa de promoções e o spam.'],
          ['Entre na área de membros', 'Use o mesmo e-mail da compra. No primeiro acesso, a Hotmart pede para criar uma senha.'],
          ['Comece pelo capítulo 3', 'Em 20 minutos você monta o primeiro agente no ChatGPT, no Gemini ou no Claude. Depois vá direto para a área da empresa que mais dói hoje.'],
        ].map(([title, text], i) => (
          <li class="card reveal flex gap-6 p-7" data-reveal-delay={150 + i * 90}>
            <span aria-hidden="true" class="eyebrow mt-1.5 shrink-0 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="text-xl">{title}</h2>
              <p class="mt-2 text-muted">{text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-12 text-sm text-muted">
        Qualquer problema com o acesso, escreva para
        <a href={`mailto:${site.author.email}`} class="text-ink underline decoration-ink/40">{site.author.email}</a>.
      </p>
      <Button href="/" variant="secondary" class="mt-10">Voltar ao início</Button>
    </div>
  </section>

  <script>
    import { track } from '../lib/tracking';
    // Sinal leve de conclusão. O evento Purchase com valor deve vir do servidor (webhook da Hotmart), não daqui.
    track('CompleteRegistration', { content_name: 'comprou' });
  </script>
</Base>
