---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import FAQ from '../../components/FAQ.astro';
import Testimonials from '../../components/Testimonials.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import BookMockup from '../../components/BookMockup.astro';
import BuyCta from '../../components/BuyCta.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site } from '../../config/site';
import { brl } from '../../lib/format';
import { resolveCover } from '../../lib/assets';
import { saleState, prelaunchLine } from '../../lib/launch';

export async function getStaticPaths() {
  const ebooks = await getCollection('ebooks', (e) => !e.data.draft);
  return ebooks.map((ebook) => ({ params: { slug: ebook.id }, props: { ebook } }));
}

const { ebook } = Astro.props;
const { data } = ebook;
const { Content } = await render(ebook);

const cover = resolveCover(ebook.id, data.cover);
const ogCover = cover ?? data.cover;
const price = brl(data.price, { cents: false });
const original = data.originalPrice ? brl(data.originalPrice, { cents: false }) : null;
const state = saleState(ebook);
const open = state === 'open';
const deadline = data.cartCloses?.toISOString();
const deadlineDay = data.cartCloses?.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', timeZone: 'America/Sao_Paulo' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.excerpt,
  image: new URL(ogCover, site.url).toString(),
  brand: { '@type': 'Person', name: site.author.name },
  offers: {
    '@type': 'Offer',
    price: data.price.toFixed(2),
    priceCurrency: 'BRL',
    availability: open ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    url: new URL(`/ebook/${ebook.id}/`, site.url).toString(),
  },
};
---

<Base title={data.title} description={data.excerpt} image={ogCover} type="product" minimal schema={schema}>
  <!-- 1. Primeira tela: a promessa do anúncio, a capa, o preço e o botão -->
  <section id="promessa" class="glow overflow-hidden">
    <div class="container-site grid items-center gap-10 pb-12 pt-6 sm:pt-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pb-20 lg:pt-16">
      <div>
        <p class="eyebrow mb-4">E-book para donos de empresa</p>
        <h1 class="text-[2rem] font-semibold leading-[1.08] tracking-[-0.03em] sm:text-5xl lg:text-6xl">{data.promise.headline}</h1>
        <p class="lead mt-5">{data.promise.support}</p>

        <div class="mt-7 grid grid-cols-[auto_1fr] items-center gap-5 lg:block">
          <div class="lg:hidden">
            <BookMockup title={data.title} subtitle={data.subtitle} cover={cover} coverAlt={data.coverAlt} width="min(7.5rem, 30vw)" priority />
          </div>
          <div>
            {original && <p class="text-sm text-muted">De <span class="line-through">{original}</span> por</p>}
            <p class="font-display text-5xl font-semibold leading-none tracking-[-0.04em]">{price}</p>
            {data.installments && <p class="mt-2 text-sm text-muted">{data.installments}</p>}
          </div>
        </div>

        <div class="mt-6 lg:max-w-md">
          <BuyCta ebook={ebook} id="cta-topo" align="stretch" />
        </div>
        {open && deadline && (
          <p class="mt-4 text-sm text-accent" data-deadline={deadline}>
            Preço de lançamento até {deadlineDay}. Depois, R$ 97.<span data-days-left></span>
          </p>
        )}
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
          <li>✓ Garantia de {data.guaranteeDays} dias</li>
          <li>✓ Acesso imediato</li>
          <li>✓ Compra segura pela Hotmart</li>
        </ul>
      </div>
      <div class="hidden lg:block">
        <BookMockup title={data.title} subtitle={data.subtitle} cover={cover} coverAlt={data.coverAlt} width="min(21rem, 72vw)" />
      </div>
    </div>
  </section>

  <!-- 2. Quem escreve e os números -->
  <section id="prova" class="section-y-sm border-t border-line">
    <div class="container-site max-w-5xl">
      {data.proof && (
        <dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
          {data.proof.map((m) => (
            <div>
              <dd class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{m.value}</dd>
              <dt class="mt-1 text-sm text-muted">{m.label}</dt>
            </div>
          ))}
        </dl>
      )}
      <div class="mt-10 flex items-start gap-4 border-t border-line pt-8">
        <img src={site.author.photo} alt={`Foto de ${site.author.name}`} width="128" height="128" loading="lazy" decoding="async" class="size-16 shrink-0 rounded-full object-cover" />
        <div>
          <p class="font-medium">{site.author.name}, {site.author.role.toLowerCase()}</p>
          <p class="mt-1 text-[0.9375rem] text-muted">Mais de 10 anos de operação. Nvoip acelerada pelo Inovativa Brasil (2019.1) e participante do ScaleUP Endeavor (2020). Mais de R$ 3 milhões captados com três fundos de venture capital.</p>
        </div>
      </div>
      {data.caseStudy.disclaimer && <p class="mt-6 text-xs text-muted">{data.caseStudy.disclaimer}</p>}
    </div>
  </section>

  <!-- 3. A dor, curta -->
  <section id="dor" class="section-y-sm border-t border-line bg-surface">
    <div class="container-site max-w-3xl">
      <h2 class="display-3">Se isto acontece na sua empresa, o livro é para você.</h2>
      <ul class="mt-8 space-y-6">
        {data.pains.map((p) => (
          <li>
            <h3 class="text-lg font-medium sm:text-xl">{p.title}</h3>
            <p class="mt-1 text-muted">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Por dentro: páginas reais -->
  {data.previews && (
    <section id="por-dentro" class="section-y-sm border-t border-line">
      <div class="container-site">
        <p class="eyebrow mb-4">Por dentro</p>
        <h2 class="display-3 max-w-3xl">Veja páginas reais antes de comprar.</h2>
        <ul class="-mx-5 mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-3 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:px-0">
          {data.previews.map((pv) => (
            <li class="w-[70vw] max-w-xs shrink-0 snap-center lg:w-auto lg:max-w-none">
              <a href={pv.src} target="_blank" rel="noopener" class="block">
                <img src={pv.src} alt={pv.alt} width="700" height="993" loading="lazy" decoding="async" class="w-full rounded-lg border border-line" />
              </a>
              <p class="mt-3 text-sm text-muted">{pv.caption}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 5. Teste agora: um prompt grátis -->
  {data.samplePrompt && (
    <section id="teste" class="section-y-sm border-t border-line bg-surface">
      <div class="container-site max-w-3xl">
        <p class="eyebrow mb-4">Teste agora, de graça</p>
        <h2 class="display-3">{data.samplePrompt.title}</h2>
        <p class="mt-4 text-muted">{data.samplePrompt.lead}</p>
        <div class="card mt-6 overflow-hidden">
          <pre id="prompt-gratis" tabindex="0" class="max-h-64 overflow-y-auto whitespace-pre-wrap p-5 font-mono text-[0.8125rem] leading-relaxed text-ink/90">{data.samplePrompt.text.trim()}</pre>
          <div class="border-t border-line p-3">
            <button type="button" id="copiar-prompt" class="w-full rounded-full border border-ink/25 px-6 py-3 text-[0.9375rem] font-medium text-ink transition-colors hover:border-ink/70">Copiar o prompt</button>
          </div>
        </div>
        <p class="mt-5 text-muted">O manual traz mais 17 como este, um para cada tarefa, e os 6 agentes prontos.</p>
      </div>
    </section>
  )}

  <!-- 6. Oferta e garantia -->
  <section id="oferta" class="section-y-sm border-t border-line">
    <div class="container-site max-w-xl">
      <p class="eyebrow mb-4 text-center">O que você recebe</p>
      <h2 class="display-3 text-center">Tudo por {price}{open && deadlineDay ? `, até ${deadlineDay}` : ''}.</h2>
      <div id="oferta-card" class="card-elevated mt-8 p-6 sm:p-9">
        {data.stack && (
          <ul class="space-y-4">
            {data.stack.map((item) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-0.5 text-success">✓</span>
                <div>
                  <p class="font-medium">{item.title}</p>
                  <p class="text-sm text-muted">{item.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        )}
        <div class="mt-7 border-t border-line pt-6 text-center">
          {original && <p class="text-muted">De <span class="line-through">{original}</span> por</p>}
          <p class="font-display text-6xl font-semibold tracking-[-0.04em]">{price}</p>
          {data.installments && <p class="mt-2 text-sm text-muted">{data.installments}</p>}
          <BuyCta ebook={ebook} id="cta-oferta" align="stretch" class="mt-6" />
          <p class="mt-4 text-xs text-muted">Pix, cartão, boleto ou PayPal. Checkout e entrega pela Hotmart. No checkout, o campo de autor mostra o MEI que publica o manual.</p>
        </div>
      </div>
      <div id="garantia" class="mt-8 flex items-center gap-5">
        <div aria-hidden="true" class="flex size-16 shrink-0 flex-col items-center justify-center rounded-full border border-accent/50 font-display">
          <span class="text-xl font-semibold leading-none">{data.guaranteeDays}</span>
          <span class="mt-0.5 text-[0.55rem] uppercase tracking-[0.14em] text-accent">dias</span>
        </div>
        <div>
          <h3 class="font-medium">Garantia incondicional de {data.guaranteeDays} dias.</h3>
          <p class="mt-1 text-sm text-muted">Leia, aplique e veja se faz sentido. Se não fizer, peça o reembolso pela Hotmart e receba 100% do valor de volta, sem perguntas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Para quem é -->
  <section id="para-quem" class="section-y-sm border-t border-line bg-surface">
    <div class="container-site grid max-w-4xl gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-medium">É para você se…</h2>
        <ul class="mt-4 space-y-3 text-ink/90">
          {data.forWho.map((t) => <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span>{t}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-medium">Não é para você se…</h2>
        <ul class="mt-4 space-y-3 text-muted">
          {data.notForWho.map((t) => <li class="flex gap-3"><span aria-hidden="true" class="text-danger">✕</span>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. Conteúdo: agentes visíveis, capítulos sob demanda -->
  <section id="conteudo-ebook" class="section-y-sm border-t border-line">
    <div class="container-site max-w-3xl">
      <p class="eyebrow mb-4">O conteúdo</p>
      <h2 class="display-3">Os 6 agentes que você monta com o manual.</h2>
      <ul class="mt-8 divide-y divide-line border-y border-line">
        {data.agents.map((a) => (
          <li class="py-4">
            <p class="font-medium">{a.name}</p>
            <p class="mt-1 text-sm text-muted">{a.what}</p>
          </li>
        ))}
      </ul>
      <details class="group mt-6 rounded-card border border-line">
        <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-medium">
          Ver os {data.chapters.length} capítulos
          <span aria-hidden="true" class="text-muted transition-transform group-open:rotate-45">+</span>
        </summary>
        <ol class="border-t border-line px-5">
          {data.chapters.map((c, i) => (
            <li class="grid grid-cols-[2rem_1fr] gap-2 border-b border-line py-4 last:border-b-0">
              <span aria-hidden="true" class="text-sm tabular-nums text-accent">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="font-medium">{c.title}</p>
                <p class="mt-1 text-sm text-muted">{c.result}</p>
              </div>
            </li>
          ))}
        </ol>
      </details>
      <div class="prose-site mt-8 text-muted">
        <Content />
      </div>
    </div>
  </section>

  <!-- 9. Depoimentos: só aparecem quando existirem, com autorização -->
  {data.testimonials.length > 0 && (
    <Section id="depoimentos" eyebrow="Quem já leu" title="O que dizem.">
      <Testimonials items={data.testimonials} />
    </Section>
  )}

  <!-- 10. Perguntas frequentes -->
  <section id="faq" class="section-y-sm border-t border-line bg-surface">
    <div class="container-site">
      <h2 class="display-3 mb-8 text-center">Perguntas frequentes</h2>
      <FAQ items={data.faq} />
    </div>
  </section>

  <!-- 11. Sobre o autor -->
  <section id="autor" class="section-y-sm border-t border-line">
    <div class="container-site max-w-3xl">
      <AuthorBox compact />
    </div>
  </section>

  <!-- 12. Fecho -->
  <section id="cta-final" class="section-y-sm border-t border-line bg-surface text-center">
    <div class="container-site max-w-2xl">
      <h2 class="display-3">IA não é obrigatório, mas é necessário para você sair na frente.</h2>
      <p class="mt-4 text-muted">
        {open ? `Garantia de ${data.guaranteeDays} dias. Acesso imediato. ${price}.` : `Garantia de ${data.guaranteeDays} dias. ${prelaunchLine(ebook)}.`}
      </p>
      <div class="mt-7">
        <BuyCta ebook={ebook} id="cta-final-botao" align="stretch" hideLine />
      </div>
    </div>
  </section>

  <!-- 13. Para quem ainda não vai comprar: amostra grátis no fim, sem competir com o botão de compra -->
  {open && (
    <section id="pdf-gratis" class="section-y-sm border-t border-line">
      <div class="container-site grid max-w-5xl items-start gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <div>
          <p class="eyebrow mb-5">Ainda não é a hora?</p>
          <h2 class="display-3">Leve um gostinho do manual, de graça.</h2>
          <p class="lead mt-5">
            São 12 tarefas da sua empresa que a IA já faz, uma por página, cada uma com o prompt pronto para copiar.
            Teste no seu negócio e decida depois.
          </p>
        </div>
        <div class="card-elevated p-7 sm:p-9">
          <h3 class="text-xl">Onde enviamos o PDF?</h3>
          <div class="mt-6">
            <LeadForm origem="ebook-saida" cta={site.leadMagnet.cta} whatsapp={false} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Barra de compra fixa no celular: some enquanto outro botão de compra estiver na tela -->
  {open && (
    <>
      <div aria-hidden="true" class="h-20 lg:hidden"></div>
      <div id="barra-compra" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-surface-2/95 px-4 py-3 backdrop-blur transition-transform duration-200 lg:hidden">
        <div class="mx-auto flex max-w-xl items-center justify-between gap-4">
          <div class="leading-tight">
            <p class="font-display text-2xl font-semibold tracking-tight">{price}</p>
            <p class="text-xs text-muted">Garantia de {data.guaranteeDays} dias</p>
          </div>
          <a href={data.checkoutUrl} data-checkout id="cta-barra" class="inline-flex items-center justify-center rounded-full bg-ink px-6 py-3 font-medium text-bg no-underline">Comprar agora</a>
        </div>
      </div>
    </>
  )}

  <!-- Dados do produto para o evento ViewContent (Meta) / view_item (GA4). -->
  <div id="ebook-data" hidden data-id={ebook.id} data-title={data.title} data-price={data.price}></div>
  <script>
    import { track } from '../../lib/tracking';

    const el = document.getElementById('ebook-data');
    if (el) {
      track('ViewContent', {
        content_ids: [el.dataset.id],
        content_name: el.dataset.title,
        content_type: 'product',
        value: Number(el.dataset.price),
        currency: 'BRL',
      });
      document.querySelectorAll('a[data-checkout]').forEach((a) =>
        a.addEventListener('click', () =>
          track('InitiateCheckout', { content_ids: [el.dataset.id], value: Number(el.dataset.price), currency: 'BRL' }),
        ),
      );
    }

    // Contagem real até o fim do preço de lançamento. Depois da data, a linha some.
    document.querySelectorAll<HTMLElement>('[data-deadline]').forEach((line) => {
      const ms = new Date(line.dataset.deadline ?? '').getTime() - Date.now();
      if (Number.isNaN(ms) || ms <= 0) {
        line.remove();
        return;
      }
      const dias = Math.ceil(ms / 864e5);
      const alvo = line.querySelector('[data-days-left]');
      if (alvo) alvo.textContent = dias === 1 ? ' Último dia.' : ` Faltam ${dias} dias.`;
    });

    // Copiar o prompt grátis.
    const botao = document.getElementById('copiar-prompt');
    const prompt = document.getElementById('prompt-gratis');
    botao?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt?.textContent ?? '');
        botao.textContent = 'Copiado. Agora cole na sua IA.';
        track('PromptCopied', { content_name: 'prompt-gratis' });
      } catch {
        botao.textContent = 'Selecione o texto acima para copiar.';
      }
    });

    // Barra fixa: aparece só quando nenhum botão de compra da página nem o formulário do PDF está visível.
    const barra = document.getElementById('barra-compra');
    const alvos = ['cta-topo', 'cta-oferta', 'cta-final-botao', 'pdf-gratis'].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    if (barra && alvos.length && 'IntersectionObserver' in window) {
      const visiveis = new Set<Element>();
      const atualizar = () => barra.classList.toggle('translate-y-full', visiveis.size > 0);
      const obs = new IntersectionObserver((entradas) => {
        entradas.forEach((e) => (e.isIntersecting ? visiveis.add(e.target) : visiveis.delete(e.target)));
        atualizar();
      });
      alvos.forEach((a) => obs.observe(a));
    }
  </script>
</Base>
