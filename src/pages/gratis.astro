---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
---

<Base title="Guia grátis" description="[PLACEHOLDER] Baixe o guia gratuito com 5 automações com IA que qualquer pequena empresa monta em uma tarde.">
  <section class="glow overflow-hidden">
    <div class="container-site grid items-start gap-12 pb-20 pt-14 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20 lg:pb-32 lg:pt-28">
      <div>
        <p class="eyebrow mb-7">Guia gratuito</p>
        <h1 class="display-1">[PLACEHOLDER] Cinco automações com IA para colocar na sua empresa esta semana.</h1>
        <p class="lead measure mt-8">[PLACEHOLDER] Um PDF curto, direto e sem teoria: cinco automações que você monta em uma tarde, com as ferramentas que já usa.</p>
        <ul class="mt-10 space-y-4 border-t border-line pt-8 text-ink/90">
          {[
            '[PLACEHOLDER] Resposta automática no WhatsApp fora do horário',
            '[PLACEHOLDER] Follow-up de orçamento que ninguém esquece',
            '[PLACEHOLDER] Resumo semanal do caixa no seu e-mail',
            '[PLACEHOLDER] Triagem de mensagens por urgência',
            '[PLACEHOLDER] Rascunho de posts a partir de uma ideia',
          ].map((item, i) => (
            <li class="flex gap-4"><span aria-hidden="true" class="eyebrow mt-1 tabular-nums">{String(i + 1).padStart(2, '0')}</span><span>{item}</span></li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-muted">Escrito por {site.author.name}, {site.author.role.toLowerCase()}.</p>
      </div>
      <div class="card-elevated reveal p-7 sm:p-9 lg:sticky lg:top-28" data-reveal-delay="120">
        <h2 class="text-2xl">Onde enviamos o guia?</h2>
        <p class="mb-7 mt-2 text-sm text-muted">Chega no e-mail em poucos minutos. WhatsApp é opcional, para quem quiser receber avisos por lá.</p>
        <LeadForm origem="gratis" cta="Quero receber o guia" />
      </div>
    </div>
  </section>
</Base>
