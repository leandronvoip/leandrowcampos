---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import LeadTitle from '../components/LeadTitle.astro';
import { site } from '../config/site';

// Doze tarefas, uma por página do PDF, cada uma com o prompt pronto.
const tasks = [
  'Responder a primeira mensagem do cliente fora do horário',
  'Resumir uma conversa longa antes de passar para alguém',
  'Escrever a proposta a partir das anotações da reunião',
  'Fazer o follow-up de quem pediu orçamento e sumiu',
  'Transformar um áudio seu em post, e-mail e anúncio',
  'Montar o calendário de conteúdo do mês',
  'Escrever a mensagem de cobrança certa para cada atraso',
  'Ler a conta do fornecedor e apontar o que contestar',
  'Conferir o fechamento do contador contra o extrato',
  'Escrever a vaga e triar os currículos',
  'Resumir a reunião e distribuir as tarefas',
  'Dar a segunda opinião antes de uma decisão',
];
---

<Base title="12 tarefas grátis" description={`${site.leadMagnet.title}. PDF gratuito, uma tarefa por página, com o prompt pronto para copiar.`}>
  <section class="glow overflow-hidden">
    <div class="container-site grid items-start gap-12 pb-20 pt-14 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20 lg:pb-32 lg:pt-28">
      <div>
        <p class="eyebrow mb-7">PDF gratuito · amostra do e-book</p>
        <LeadTitle as="h1" class="display-1" />
        <p class="lead measure mt-8">{site.leadMagnet.description} Nenhuma exige programar ou contratar ferramenta nova.</p>
        <ol class="mt-10 grid gap-3 border-t border-line pt-8 text-ink/90 sm:grid-cols-2 sm:gap-x-8">
          {tasks.map((item, i) => (
            <li class="flex gap-4"><span aria-hidden="true" class="eyebrow mt-1 tabular-nums">{String(i + 1).padStart(2, '0')}</span><span>{item}</span></li>
          ))}
        </ol>
        <p class="mt-8 text-sm text-muted">Escrito por {site.author.name}, {site.author.role.toLowerCase()}, que reduziu o próprio time de 70 para 10 pessoas com IA.</p>
        <p class="mt-4 text-sm text-muted">Gostou das 12? O e-book <a href="/ebook/ia-no-negocio/" class="text-accent">IA no Negócio</a> é o manual inteiro: as 10 áreas da empresa, os prompts e os 6 agentes prontos para copiar.</p>
      </div>
      <div class="card-elevated reveal p-7 sm:p-9 lg:sticky lg:top-28" data-reveal-delay="120">
        <h2 class="text-2xl">Onde enviamos o PDF?</h2>
        <p class="mb-7 mt-2 text-sm text-muted">Chega no e-mail em poucos minutos. WhatsApp é opcional, para quem quiser receber avisos por lá.</p>
        <LeadForm origem="gratis" cta={site.leadMagnet.cta} />
      </div>
    </div>
  </section>
</Base>
