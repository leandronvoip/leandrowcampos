---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import LeadForm from '../components/LeadForm.astro';
import LeadTitle from '../components/LeadTitle.astro';
import Portrait from '../components/Portrait.astro';
import BookMockup from '../components/BookMockup.astro';
import Pinned from '../components/Pinned.astro';
import AgentCard from '../components/AgentCard.astro';
import Icon from '../components/Icon.astro';
import BuyCta from '../components/BuyCta.astro';
import { site } from '../config/site';
import { brl } from '../lib/format';
import { resolveCover } from '../lib/assets';
import { saleState, prelaunchLine } from '../lib/launch';

const featured =
  (await getEntry('ebooks', site.launch.featuredEbook)) ??
  (await getCollection('ebooks', (e) => !e.data.draft))[0];
const cover = featured ? resolveCover(featured.id, featured.data.cover) : null;
const state = featured ? saleState(featured) : 'prelaunch';

// Três provas, uma por tela. Fatos confirmados por Leandro em 26/10/2026.
const proofs = [
  {
    icon: 'sparkles',
    eyebrow: 'O dado mais forte',
    title: 'De 70 para 10 pessoas no time, com IA e automação de processos.',
    text: `A ${site.company.name}, plataforma de telefonia e comunicação em nuvem com mais de dez anos de operação e mais de 50 mil clientes atendidos, hoje roda com um time sete vezes menor. Não foi corte: foi IA e automação assumindo atendimento, cobrança, análise de contas e parte do desenvolvimento.`,
    link: { href: site.company.url, label: `Conheça a ${site.company.name}`, external: true },
    stats: site.company.proof,
  },
  {
    icon: 'building',
    eyebrow: 'Empresa real',
    title: 'Fundador de uma empresa de tecnologia em operação, não de um curso.',
    text: 'Captou mais de R$ 3 milhões em duas rodadas com três fundos de venture capital. Desenvolveu sistemas complexos de telecom e atendimento, montou e coordenou projetos de tecnologia. Mentor do Inovativa Brasil por quatro anos.',
  },
  {
    icon: 'flag',
    eyebrow: 'Trajetória',
    title: '15 anos empreendendo, 8 à frente de uma empresa 100% digital.',
    text: 'Antes da Nvoip, hardware, redes e consultoria. O que está aqui é o critério de quem precisa que funcione na segunda-feira: frases curtas, passo a passo, sem jargão e sem promessa que a sua empresa não consegue cumprir.',
  },
];
---

<Base title={`${site.name} | ${site.tagline}`} description={site.description}>
  <!-- 1. Herói: afirmação e retrato -->
  <section class="glow glow--ember overflow-hidden">
    <div class="container-site grid items-center gap-12 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pb-24 lg:pt-28">
      <div>
        <p class="eyebrow mb-7">{site.author.name} · {site.author.role}</p>
        <h1 class="display-1">15 anos empreendendo. O que funciona, sem enfeite.</h1>
        <p class="lead measure mt-8">
          Conteúdo, cursos e consultoria sobre negócios, tecnologia e gestão, por quem toca uma empresa todos os dias. Primeira série: IA no negócio.
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button href="/gratis" size="lg">{site.leadMagnet.cta}</Button>
          <Button href="/ebooks" variant="secondary" size="lg">Ver os e-books</Button>
        </div>
      </div>
      <Portrait priority class="mx-auto w-full max-w-sm lg:max-w-md" ratio="3 / 4" />
    </div>
  </section>

  <!-- 2. Três provas, uma por tela -->
  {proofs.map((p, i) => (
    <section id={i === 0 ? 'prova' : undefined} class:list={['section-y', i % 2 === 0 && 'border-t border-line']}>
      <div class="container-site">
        <div class="reveal mx-auto max-w-4xl text-center">
          <span class:list={['mx-auto mb-6 flex size-12 items-center justify-center rounded-full border border-line', i === 0 ? 'text-accent' : 'text-muted']}>
            <Icon name={p.icon} />
          </span>
          <p class="eyebrow mb-6">{String(i + 1).padStart(2, '0')} · {p.eyebrow}</p>
          <h2 class="display-2">{p.title}</h2>
          <p class="lead measure mx-auto mt-8">{p.text}</p>
          {p.link && (
            <a href={p.link.href} rel={p.link.external ? 'noopener' : undefined} target={p.link.external ? '_blank' : undefined} class="mt-8 inline-block font-medium text-accent no-underline hover:text-ink">
              {p.link.label} →
            </a>
          )}
        </div>
        {p.stats && (
          <dl class="reveal mx-auto mt-16 grid max-w-3xl gap-8 border-t border-line pt-10 sm:grid-cols-3" data-reveal-delay="150">
            {p.stats.map((s) => (
              <div class="text-center">
                <dd class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">{s.value}</dd>
                <dt class="mt-2 text-sm text-muted">{s.label}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  ))}

  <!-- 3. O que você encontra aqui: as frentes do conteúdo -->
  <section id="frentes" class="section-y bg-surface">
    <div class="container-site">
      <header class="reveal mx-auto mb-14 max-w-3xl text-center sm:mb-20">
        <p class="eyebrow mb-5">O que você encontra aqui</p>
        <h2 class="display-2">Seis frentes. Uma empresa inteira.</h2>
        <p class="lead measure mx-auto mt-6">O que aprendi tocando uma empresa por quinze anos, organizado em conteúdo, cursos e consultoria. A IA entra em todas elas e abre a série.</p>
      </header>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {site.topics.map((t, i) => (
          <li class="card reveal group p-7 sm:p-8" data-reveal-delay={(i % 3) * 90}>
            <span class:list={['transition-colors duration-300', t.icon === 'sparkles' ? 'text-accent' : 'text-muted group-hover:text-accent']}>
              <Icon name={t.icon} />
            </span>
            <h3 class="mt-5 text-xl sm:text-2xl">{t.title}</h3>
            <p class="mt-3 text-muted">{t.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. O e-book em destaque: primeira série -->
  {featured && (
    <section id="ebook" class="glow section-y overflow-hidden border-t border-line">
      <div class="container-site">
        <div class="mx-auto grid max-w-5xl items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
          <a href={`/ebook/${featured.id}/`} class="reveal block no-underline">
            <BookMockup title={featured.data.title} subtitle={featured.data.subtitle} cover={cover} coverAlt={featured.data.coverAlt} width="min(20rem, 70vw)" class="lg:mr-0" />
          </a>
          <div class="reveal" data-reveal-delay="120">
            <p class="eyebrow mb-6">Primeira série · IA no negócio</p>
            <h2 class="display-2">{featured.data.title}</h2>
            <p class="lead measure mt-6">{featured.data.subtitle}</p>
            <ul class="mt-8 space-y-3 border-t border-line pt-8">
              {featured.data.chapters.slice(1, 4).map((c) => (
                <li class="flex gap-4 text-ink/90"><span aria-hidden="true" class="mt-0.5 text-accent">—</span><span>{c.result}</span></li>
              ))}
            </ul>
            <p class="mt-10 flex items-baseline gap-3">
              <span class="font-display text-5xl font-semibold tracking-tight sm:text-6xl">{brl(featured.data.price, { cents: false })}</span>
              {featured.data.originalPrice && <span class="text-muted line-through">{brl(featured.data.originalPrice, { cents: false })}</span>}
            </p>
            {featured.data.installments && <p class="mt-1 text-sm text-muted">{featured.data.installments}</p>}
            <div class="mt-8 flex flex-col gap-4">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                {state === 'open' ? (
                  <>
                    <BuyCta ebook={featured} id="cta-home" />
                    <Button href={`/ebook/${featured.id}/`} variant="secondary" size="lg">Conhecer o e-book</Button>
                  </>
                ) : (
                  <>
                    <Button href={`/ebook/${featured.id}/`} size="lg">Conhecer o e-book</Button>
                    <BuyCta ebook={featured} id="cta-home" hideLine />
                  </>
                )}
              </div>
              {state === 'prelaunch' && <p class="text-sm text-muted">{prelaunchLine(featured)}</p>}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 5. Seis agentes para começar (pinned) -->
  {featured && featured.data.agents.length > 0 && (
    <Pinned id="agentes" alt eyebrow="O que você monta" title="Seis agentes para começar." lead="Os seis que mais devolvem tempo. O manual cobre as dez áreas da empresa; você monta um por vez, sem equipe técnica.">
      {featured.data.agents.map((a, i) => (
        <AgentCard index={i + 1} name={a.name} text={a.what} area={a.area} icon={a.icon} highlight={i === 0} delay={(i % 3) * 90} />
      ))}
    </Pinned>
  )}

  <!-- 6. A isca gratuita -->
  <section id="gratis" class="section-y border-t border-line">
    <div class="container-site">
      <div class="mx-auto grid max-w-5xl items-start gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-6">Comece de graça</p>
          <LeadTitle as="h2" class="display-2" />
          <p class="lead measure-sm mt-6">{site.leadMagnet.description} Chega no seu e-mail em minutos.</p>
        </div>
        <div class="card-elevated reveal p-7 sm:p-9" data-reveal-delay="120">
          <LeadForm origem="home-isca" cta={site.leadMagnet.cta} />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Fecho -->
  <section class="section-y border-t border-line bg-surface">
    <div class="container-site">
      <p class="reveal display-2 mx-auto max-w-4xl text-center">Menos promessa. Mais operação.</p>
      <p class="reveal mx-auto mt-8 max-w-xl text-center text-muted" data-reveal-delay="120">
        Tudo o que está aqui foi testado numa empresa que paga folha todo mês. Se não devolver tempo ou dinheiro, não entra.
      </p>
    </div>
  </section>
</Base>
