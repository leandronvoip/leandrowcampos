---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import LeadForm from '../components/LeadForm.astro';
import BookMockup from '../components/BookMockup.astro';
import { site } from '../config/site';
import { longDate, shortDate } from '../lib/format';
import { resolveCover } from '../lib/assets';
import { prelaunchLine } from '../lib/launch';

const ebook = await getEntry('ebooks', site.launch.featuredEbook);
const cover = ebook ? resolveCover(ebook.id, ebook.data.cover) : null;

/** Data N dias antes da abertura do carrinho (as datas do aquecimento seguem site.launch). */
const daysBefore = (n: number) => new Date(new Date(site.launch.cartOpens).getTime() - n * 864e5);

// Três conteúdos de aquecimento, por e-mail, na semana anterior à abertura.
// Os temas são os capítulos 1, 3 e 13 do manual. Quando houver link (vídeo, post, live), adicione `href`.
const warmup: { date: Date; title: string; text: string; href?: string }[] = [
  {
    date: daysBefore(7),
    title: 'Equipe enxuta: o que a IA faz no lugar de uma contratação',
    text: 'Como a Nvoip passou de 70 para 10 pessoas e a tabela função × IA × humano para você decidir antes de abrir a próxima vaga.',
  },
  {
    date: daysBefore(5),
    title: 'Monte seu primeiro agente em 20 minutos',
    text: 'O passo a passo do capítulo 3, em ChatGPT, Gemini ou Claude, com a instrução completa do Atendente de WhatsApp.',
  },
  {
    date: daysBefore(2),
    title: 'A semana com os agentes e a abertura do carrinho',
    text: 'Como fica a rotina com os seis agentes rodando, o que não entregar à IA e a condição de abertura do manual.',
  },
];
---

<Base title="Lançamento" description={`Carrinho aberto de ${shortDate(site.launch.cartOpens)} a ${shortDate(site.launch.cartCloses)}. Entre na lista para acompanhar o aquecimento e receber a oferta.`}>
  <section class="glow overflow-hidden">
    <div class="container-site grid items-center gap-12 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-28 lg:pt-28">
      <div>
        <p class="eyebrow mb-7">Lançamento · {longDate(site.launch.cartOpens)}</p>
        <h1 class="display-1">{ebook?.data.title ?? 'IA no Negócio'}</h1>
        <p class="lead measure mt-8">
          Carrinho aberto de <strong class="font-medium text-ink">{shortDate(site.launch.cartOpens)}</strong> a
          <strong class="font-medium text-ink">{shortDate(site.launch.cartCloses)}</strong>. Antes disso, três conteúdos gratuitos para você já sair aplicando.
        </p>
        {ebook && <p class="mt-6 text-sm text-muted">{prelaunchLine(ebook)}.</p>}
        <div id="lista" class="card-elevated mt-10 p-7 sm:p-9">
          <h2 class="text-2xl">Entre na lista de abertura</h2>
          <p class="mb-7 mt-2 text-sm text-muted">Você recebe os três conteúdos e a condição de abertura antes de todo mundo.</p>
          <LeadForm origem="lancamento" cta="Quero entrar na lista" />
        </div>
      </div>
      {ebook && (
        <div class="reveal hidden lg:block" data-reveal-delay="150">
          <BookMockup title={ebook.data.title} subtitle={ebook.data.subtitle} cover={cover} coverAlt={ebook.data.coverAlt} width="19rem" />
        </div>
      )}
    </div>
  </section>

  <Section alt eyebrow="Aquecimento" title="Três conteúdos antes do carrinho abrir." lead={`Chegam por e-mail entre ${shortDate(warmup[0].date)} e ${shortDate(warmup[2].date)}, para quem estiver na lista.`}>
    <ol class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
      {warmup.map((w, i) => (
        <li class="card reveal flex flex-col p-7" data-reveal-delay={i * 100}>
          <span class="eyebrow text-[0.75rem]">Conteúdo {i + 1} · {shortDate(w.date)}</span>
          <h3 class="mt-4 text-xl">{w.title}</h3>
          <p class="mt-3 flex-1 text-muted">{w.text}</p>
          {w.href ? (
            <a href={w.href} class="mt-6 text-sm font-medium text-accent no-underline hover:text-ink">Assistir →</a>
          ) : (
            <p class="mt-6 text-sm text-muted">Chega por e-mail para a lista.</p>
          )}
        </li>
      ))}
    </ol>
  </Section>

  <Section narrow>
    <div class="reveal mx-auto max-w-xl text-center">
      <h2 class="display-3">Já conhece o e-book?</h2>
      <p class="mt-4 text-muted">A página completa de venda, com conteúdo, bônus e garantia, já está disponível.</p>
      {ebook && <a href={`/ebook/${ebook.id}/`} class="mt-6 inline-block font-medium text-accent no-underline hover:text-ink">Ver a página do e-book →</a>}
    </div>
  </Section>
</Base>
