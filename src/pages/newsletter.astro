---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
---

<Base title="Newsletter" description="[PLACEHOLDER] Um e-mail por semana sobre IA aplicada a pequenas e médias empresas, com o que funcionou (e o que não funcionou) na prática.">
  <section class="glow overflow-hidden">
    <div class="container-site grid max-w-5xl items-start gap-12 pb-20 pt-14 sm:pt-20 lg:grid-cols-2 lg:gap-20 lg:pb-32 lg:pt-28">
      <div>
        <p class="eyebrow mb-7">Newsletter</p>
        <h1 class="display-1">[PLACEHOLDER] IA no negócio, toda semana, em 5 minutos.</h1>
        <p class="lead measure mt-8">[PLACEHOLDER] Um e-mail por semana com uma automação, um erro que cometi e uma ferramenta que vale testar. Escrito por {site.author.name}.</p>
        <ul class="mt-10 space-y-4 border-t border-line pt-8 text-muted">
          <li class="flex gap-4"><span aria-hidden="true" class="text-accent">—</span>[PLACEHOLDER] Sem teoria: o que rodou de verdade na Nvoip</li>
          <li class="flex gap-4"><span aria-hidden="true" class="text-accent">—</span>[PLACEHOLDER] Sempre com um passo prático para a semana</li>
          <li class="flex gap-4"><span aria-hidden="true" class="text-accent">—</span>Cancela com um clique, quando quiser</li>
        </ul>
      </div>
      <div class="card-elevated reveal p-7 sm:p-9 lg:sticky lg:top-28" data-reveal-delay="120">
        <LeadForm origem="newsletter" cta="Quero receber a newsletter" whatsapp={false} />
      </div>
    </div>
  </section>
</Base>
