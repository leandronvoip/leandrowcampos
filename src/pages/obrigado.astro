---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
import { shortDate } from '../lib/format';
---

<Base title="Obrigado" description="Inscrição confirmada." noindex>
  <section class="glow overflow-hidden">
    <div class="container-site max-w-2xl py-20 text-center sm:py-32">
      <p class="eyebrow mb-7">Inscrição recebida</p>
      <h1 class="display-2">Obrigado. Agora confira seu e-mail.</h1>
      <p class="lead mx-auto mt-8">
        Em poucos minutos chega uma mensagem de <strong class="font-medium text-ink">{site.author.email}</strong>
        <span data-only="gratis home-isca ebooks-isca"> com o PDF das 12 tarefas</span>.
        Se não aparecer, olhe a caixa de promoções ou o spam e marque como “não é spam”.
      </p>
      <p data-wa class="mt-4 hidden text-muted">Você também vai receber um “oi” no WhatsApp para confirmar o número.</p>

      <div class="card reveal mt-14 p-7 text-left sm:p-9" data-reveal-delay="180">
        <h2 class="text-xl sm:text-2xl">Enquanto espera</h2>
        <ul class="mt-5 space-y-4 text-muted">
          <li class="flex gap-4"><span aria-hidden="true" class="text-accent">→</span><span><a href="/sobre" class="text-ink no-underline hover:text-accent">Conheça a história</a>: quinze anos empreendendo e o ano em que a IA mudou a empresa.</span></li>
          <li class="flex gap-4"><span aria-hidden="true" class="text-accent">→</span><span><a href="/lancamento" class="text-ink no-underline hover:text-accent">Veja o lançamento</a>: o e-book abre carrinho de {shortDate(site.launch.cartOpens)} a {shortDate(site.launch.cartCloses)}.</span></li>
          <li class="flex gap-4"><span aria-hidden="true" class="text-accent">→</span><span><a href={site.social.linkedin} rel="noopener" target="_blank" class="text-ink no-underline hover:text-accent">Siga no LinkedIn</a> para acompanhar os bastidores.</span></li>
        </ul>
      </div>
      <Button href="/" variant="secondary" class="mt-10">Voltar ao início</Button>
    </div>
  </section>

  <script>
    // Ajusta a mensagem pela origem do formulário (?origem=) e mostra o aviso do WhatsApp (?wa=1).
    const params = new URLSearchParams(location.search);
    if (params.get('wa') === '1') document.querySelector('[data-wa]')?.classList.remove('hidden');
    const origem = params.get('origem') ?? '';
    document.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => {
      const allowed = (el.dataset.only ?? '').split(' ');
      if (!allowed.includes(origem)) el.remove();
    });
  </script>
</Base>
