---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  jobTitle: site.author.role,
  url: site.url,
  image: new URL(site.author.photo, site.url).toString(),
  worksFor: { '@type': 'Organization', name: site.company.name, url: site.company.url },
  sameAs: [site.social.linkedin, site.social.instagram, site.social.youtube],
};
---

<Base title="Sobre" description={`Quem é ${site.author.name}: ${site.author.role.toLowerCase()} e autor de e-books sobre IA aplicada a pequenas e médias empresas.`} schema={schema}>
  <section class="bg-surface-alt">
    <div class="container-site grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[0.8fr_1.2fr]">
      <img src={site.author.photo} alt={`Foto de ${site.author.name}`} width="480" height="480" class="mx-auto aspect-square w-full max-w-sm rounded-card border border-line object-cover shadow-card" />
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-700">Sobre</p>
        <h1 class="text-4xl sm:text-5xl">{site.author.name}</h1>
        <p class="mt-2 text-lg text-muted">{site.author.role}</p>
        <div class="mt-6 space-y-3 text-lg">
          {site.author.bioShort.map((line) => <p>{line}</p>)}
        </div>
      </div>
    </div>
  </section>

  <Section narrow>
    <div class="prose-site">
      <h2>[PLACEHOLDER] A história</h2>
      <p>[PLACEHOLDER] Como a Nvoip nasceu, o que foi construído e o que isso tem a ver com IA hoje. Três a cinco parágrafos em primeira pessoa.</p>
      <h2>[PLACEHOLDER] Por que escrevo sobre IA para PMEs</h2>
      <p>[PLACEHOLDER] A frustração com o excesso de hype, a experiência de aplicar na própria empresa e o compromisso com o que funciona na prática.</p>
      <h2>[PLACEHOLDER] O que você encontra aqui</h2>
      <ul>
        <li>[PLACEHOLDER] E-books práticos, com passo a passo e exemplos reais.</li>
        <li>[PLACEHOLDER] Blog e newsletter com o que rodou (e o que não rodou) na Nvoip.</li>
        <li>[PLACEHOLDER] Conteúdo gratuito para começar hoje.</li>
      </ul>
    </div>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href="/ebooks">Ver os e-books</Button>
      <Button href="/newsletter" variant="secondary">Assinar a newsletter</Button>
    </div>
  </Section>
</Base>
